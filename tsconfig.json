{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "assets/**/*.ts", "tests/**/*.ts"]
}
